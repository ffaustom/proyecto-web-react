NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publica

# Solo servidor: UUID de Supabase Auth, igual al configurado en la migración RLS.
ADMIN_USER_ID=

# Checkout Pro: preparación exclusiva de pruebas. Nunca usar NEXT_PUBLIC_ para secretos.
# Usar el Access Token de prueba indicado por Mercado Pago; su prefijo puede ser APP_USR.
MP_ACCESS_TOKEN=
MP_TEST_MODE=true
# Origen HTTPS del Preview (sin rutas ni query). No se deriva del Host del navegador.
APP_URL=
# Opcional: por defecto APP_URL/api/mercado-pago/webhook.
MP_NOTIFICATION_URL=
# Clave privada de Supabase para leer reservas, exclusivamente en el servidor.
SUPABASE_SERVICE_ROLE_KEY=
# Activar únicamente después de aplicar y verificar la migración de coordinación.
MP_CHECKOUT_ENABLED=false
# Secreto aleatorio independiente, de al menos 32 bytes. Exclusivo del servidor.
CHECKOUT_SIGNING_SECRET=
# Clave de firma entregada por Mercado Pago Developers > Webhooks.
# Independiente de CHECKOUT_SIGNING_SECRET. Solo servidor.
MP_WEBHOOK_SECRET=
# ID numérico del vendedor de prueba asociado al MP_ACCESS_TOKEN.
MP_WEBHOOK_COLLECTOR_ID=
